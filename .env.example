# Copy to .env.local and fill in once the coin exists. All optional.
VITE_TOKEN_NAME=Detective Coin
VITE_TOKEN_SYMBOL=$LUCIEN
# SPL mint address of the launched token (leave empty before launch)
VITE_TOKEN_MINT=
# Any Solana JSON-RPC endpoint (public mainnet RPC is rate-limited)
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Whole tokens needed for holder cosmetics
VITE_TOKEN_HOLDER_MIN=1000
# Link for the "Get $TOKEN" button (DEX / launchpad page)
VITE_TOKEN_BUY_URL=
# Remote leaderboard base URL: GET ?limit=N returns entries, POST accepts one
VITE_LEADERBOARD_URL=
