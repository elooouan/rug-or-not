  "id": "seam",
  "title": "The Tailor",
  "ticker": "$SEAM",
  "pitch": "Seamless: cross-chain settlement with a human face. Every box ticked.",
  "intro": "No name on the folder. Everything in it checks out. That's the problem. Read it twice.",
  "difficulty": 5,
  "verdict": "rug",
  "timeLimitSec": 360,
  "secret": true,
  "debrief": "Seamless was the Tailor's best suit. Ownership renounced, but every transfer runs through a library the registrar can swap out from under it. The audit covered the token and politely skipped that library. Six 'community' wallets, funded in one block, hold a third of the supply. One bio was lifted word for word from the Harbor co-op, and three fans posted the same sentence at 20:14. The lock, the auditor, the answered questions: all real, all stitched on. You read it twice. That's the whole job.",
  "documents": [
    {
      "type": "contract",
      "title": "SeamToken.sol",
      "content": {
        "fileName": "contracts/SeamToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract SeamToken is ERC20, Ownable {",
          "  uint256 public constant MAX_SUPPLY = 60_000_000e18;",
          "  address public registrar;",
          "  address public seamLib; // settlement logic, upgradeable",
          "",
          "  constructor(address _registrar, address _lib) ERC20(\"Seamless\", \"SEAM\") {",
          "    registrar = _registrar; seamLib = _lib;",
          "    _mint(msg.sender, MAX_SUPPLY);",
          "    renounceOwnership();",
          "  }",
          "",
          "  function setSeamLib(address lib) external {",
          "    require(msg.sender == registrar, \"registrar\");",
          "    seamLib = lib;",
          "  }",
          "",
          "  function _update(address f, address t, uint256 v)",
          "    internal override {",
          "    (bool ok, ) = seamLib.delegatecall(",
          "      abi.encodeWithSignature(\"settle(address,address,uint256)\", f, t, v));",
          "    require(ok, \"settle\");",
          "  }",
          "}"
        ]
      },
