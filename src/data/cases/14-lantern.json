  "pitch": "Lantern: a night-market festival token. 3% fee, loud chat, an audit with findings.",
  "intro": "Everything about this one looks like trouble at a glance. Look twice. That's the whole job.",
  "difficulty": 5,
  "verdict": "legit",
  "timeLimitSec": 300,
  "debrief": "Lantern is loud, fee-charging and run by someone called Captain Noodle, and none of that is a crime. The 3% fee is a constant that pays the festival's stall fund, the supply is fixed, ownership is renounced with no operator or proxy left behind, liquidity is locked for four years, the audit found two real issues and the fixes shipped, and the angriest person in chat got straight answers. Scary is not the same as guilty.",
  "documents": [
    {
      "type": "contract",
      "title": "LanternToken.sol",
      "content": {
        "fileName": "contracts/LanternToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract LanternToken is ERC20 {",
          "  uint256 public constant FEE_BPS = 300; // 3%, immutable",
          "  address public immutable stallFund;",
          "  uint256 public constant MAX_SUPPLY = 8_000_000e18;",
          "",
          "  constructor(address _stallFund) ERC20(\"Lantern\", \"LNTRN\") {",
          "    stallFund = _stallFund;",
          "    _mint(msg.sender, MAX_SUPPLY);",
          "  }",
          "",
          "  // No owner, no operator, no proxy. What you see is what runs.",
          "  function _update(address f, address t, uint256 v)",
          "    internal override {",
          "    uint256 fee = v * FEE_BPS / 10_000;",
          "    super._update(f, stallFund, fee);",
          "    super._update(f, t, v - fee);",
          "  }",
          "}"
        ]
      },
