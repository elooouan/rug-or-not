        "lines": [
          "pragma solidity ^0.8.0;",
          "contract GrandmaCoin is ERC20, Ownable {",
          "  uint256 public constant TAX_BPS = 200; // 2% fixed",
          "  mapping(address => bool) private _naughty;",
          "",
          "  function setNaughty(address who, bool on) external onlyOwner {",
          "    _naughty[who] = on;",
          "  }",
          "",
          "  function _update(address from, address to, uint256 v)",
          "    internal override {",
          "    require(!_naughty[from], \"no cookies for you\");",
          "    uint256 fee = v * TAX_BPS / 10_000;",
          "    super._update(from, kitchen, fee);",
          "    super._update(from, to, v - fee);",
          "  }",
          "",
          "  function bakeMore() external onlyOwner {",
          "    // reserved for future oven upgrades",
          "  }",
          "}"
        ]
      },
