  "debrief": "Archive has an admin, and that is the scary part until you read it: every admin action sits in a public 48-hour timelock, the emergency pause auto-expires, and the multisig is three named people. Real audit, real findings, real fixes. The most boring project on the desk, and the safest.",
  "documents": [
    {
      "type": "contract",
      "title": "ArchiveToken.sol",
      "content": {
        "fileName": "contracts/ArchiveToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract ArchiveToken is ERC20 {",
          "  address public immutable timelock; // 48h, public queue",
          "  uint256 public constant MAX_SUPPLY = 25_000_000e18;",
          "  bool public paused;",
          "  uint256 public pauseEnds;",
          "",
          "  modifier onlyTimelock() {",
          "    require(msg.sender == timelock, \"queue it\"); _;",
          "  }",
          "",
          "  constructor(address _timelock) ERC20(\"Archive\", \"ARCV\") {",
          "    timelock = _timelock;",
          "    _mint(_timelock, MAX_SUPPLY);",
          "  }",
          "",
          "  // Emergency stop, expires on its own after 72h.",
          "  function pause() external onlyTimelock {",
          "    paused = true; pauseEnds = block.timestamp + 72 hours;",
          "  }",
          "",
          "  function _update(address f, address t, uint256 v)",
          "    internal override {",
          "    require(!paused || block.timestamp > pauseEnds);",
          "    super._update(f, t, v);",
          "  }",
          "}"
        ]
      },
