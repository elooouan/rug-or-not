        "fileName": "contracts/VaultlineToken.sol (proxy)",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.20;",
          "// Deployed behind TransparentUpgradeableProxy",
          "contract VaultlineToken is ERC20Upgradeable, OwnableUpgradeable {",
          "  uint256 public dailyYieldBps;",
          "",
          "  function initialize() public initializer {",
          "    __ERC20_init(\"Vaultline\", \"VLT\");",
          "    __Ownable_init(msg.sender);",
          "    dailyYieldBps = 50; // 0.5% / day",
          "    _mint(msg.sender, 20_000_000e18);",
          "    renounceOwnership();",
          "  }",
          "",
          "  function _update(address from, address to, uint256 v)",
          "    internal override {",
          "    _beforeTransferHook(from, to, v);",
          "    super._update(from, to, v);",
          "  }",
          "}"
        ]
      },
