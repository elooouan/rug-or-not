  "pitch": "NapkinPay: restaurant rewards on-chain. Renounced, audited, 20% monthly from tips.",
  "intro": "Renounced and audited, they say. Read who can still mint, and what exactly got audited.",
  "difficulty": 4,
  "verdict": "rug",
  "timeLimitSec": 300,
  "debrief": "NapkinPay renounced ownership on stage and kept an 'operator' backstage who can mint rewards to anyone. The audit certificate was for a different file with a perfect score and no findings. The liquidity lock had four days left, and '20% monthly, guaranteed' came straight from the admin. The fixed 1% tip fee and a well-vested marketing wallet were the parts they wanted you to read.",
  "documents": [
    {
      "type": "contract",
      "title": "NapkinPay.sol",
      "content": {
        "fileName": "contracts/NapkinPay.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract NapkinPay is ERC20, Ownable {",
          "  uint256 public constant TIP_FEE_BPS = 100; // 1%, fixed",
          "  address public operator;",
          "  address public treasury;",
          "",
          "  constructor() ERC20(\"NapkinPay\", \"NAPKIN\") {",
          "    _mint(msg.sender, 100_000_000e18);",
          "    operator = msg.sender;",
          "    renounceOwnership();",
          "  }",
          "",
          "  // Restaurant rewards are settled off-chain and minted here.",
          "  function rewardMint(address to, uint256 amount) external {",
          "    require(msg.sender == operator, \"operator\");",
          "    _mint(to, amount);",
          "  }",
          "",
          "  function _update(address f, address t, uint256 v)",
          "    internal override {",
          "    uint256 fee = v * TIP_FEE_BPS / 10_000;",
          "    super._update(f, treasury, fee);",
          "    super._update(f, t, v - fee);",
          "  }",
          "}"
        ]
      },
