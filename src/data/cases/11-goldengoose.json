  "title": "The Goose That Laid",
  "ticker": "$GOOSE",
  "pitch": "GoldenGoose lays a golden egg every day. Hold the goose, eat the eggs.",
  "intro": "A goose that lays golden eggs. Ask where eggs come from when nobody's buying.",
  "difficulty": 3,
  "verdict": "rug",
  "timeLimitSec": 240,
  "debrief": "The goose had a function called layEgg() that minted as many tokens as the owner wanted, whenever it wanted. Daily 'eggs' were guaranteed returns with feathers on. The farm's 28% was liquid on day one and the chat was a barn full of identical honks. The chart's volume was two wallets passing the same 6.4 million eggs back and forth every six minutes.",
  "documents": [
    {
      "type": "contract",
      "title": "GoldenGoose.sol",
      "content": {
        "fileName": "contracts/GoldenGoose.sol",
        "verified": true,
        "lines": [
          "pragma solidity ^0.8.0;",
          "contract GoldenGoose is ERC20, Ownable {",
          "  uint256 public eggRate = 100; // eggs per 10k, daily",
          "  address public farm;",
          "",
          "  constructor() ERC20(\"GoldenGoose\", \"GOOSE\") {",
          "    _mint(msg.sender, 500_000_000e18);",
          "  }",
          "",
          "  function layEgg(address nest, uint256 eggs)",
          "    external onlyOwner {",
          "    _mint(nest, eggs);",
          "  }",
          "",
          "  function setEggRate(uint256 r) external onlyOwner {",
          "    eggRate = r;",
          "  }",
          "",
          "  function claimEggs() external {",
          "    uint256 eggs = balanceOf(msg.sender) * eggRate / 10_000;",
          "    _mint(msg.sender, eggs);",
          "  }",
          "}"
        ]
      },
