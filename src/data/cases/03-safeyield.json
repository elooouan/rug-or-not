        "lines": [
          "pragma solidity ^0.8.0;",
          "contract SafeYieldVault is Ownable {",
          "  address private immutable _admin;",
          "  uint256 public fee = 3;",
          "  uint256 public constant MAX_FEE = 10;",
          "",
          "  constructor() { _admin = msg.sender; }",
          "",
          "  modifier onlyAdmin() {",
          "    require(msg.sender == _admin); _;",
          "  }",
          "",
          "  function renounceOwnership() public override onlyOwner {",
          "    super.renounceOwnership(); // fully renounced!",
          "  }",
          "",
          "  function setFee(uint256 f) external onlyAdmin {",
          "    fee = f;",
          "  }",
          "",
          "  function deposit() external payable {",
          "    shares[msg.sender] += msg.value * (100 - fee) / 100;",
          "  }",
          "}"
        ]
      },
