  "ticker": "$TRAM",
  "pitch": "NightTram: ride credits for the late line. Two founders, readable code, busy chart.",
  "intro": "A transit token with a busy chart and a small team. Read who holds the keys, and who's doing all that trading.",
  "difficulty": 4,
  "verdict": "rug",
  "timeLimitSec": 300,
  "secret": false,
  "debrief": "NightTram's code was honest and the team was real, which is why it worked. The contract sat behind an upgradeable proxy whose admin was one wallet: every promise in the source lasted until the next upgrade. The 'volume' was two wallets passing the same 3.2 million credits back and forth every five minutes, both funded by the deployer the night before launch. The chat had a fake 'closing soon' countdown on a sale that had no end date. The two named founders, the long lock and the fixed fare fee were real, and none of them could stop an upgrade.",
  "documents": [
    {
      "type": "contract",
      "title": "NightTram.sol",
      "content": {
        "fileName": "contracts/NightTram.sol (implementation)",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "// deployed behind TransparentUpgradeableProxy",
          "// proxy admin: 0x6c1...f0a",
          "contract NightTram is",
          "  ERC20Upgradeable, OwnableUpgradeable {",
          "  uint256 public constant FARE_BPS = 100; // 1%, fixed",
          "  address public depot;",
          "",
          "  function initialize() public initializer {",
          "    __ERC20_init(\"NightTram\", \"TRAM\");",
          "    __Ownable_init(msg.sender);",
          "    _mint(msg.sender, 60_000_000e18);",
          "  }",
          "",
          "  function _update(address f, address t, uint256 v)",
          "    internal override {",
          "    uint256 fare = v * FARE_BPS / 10_000;",
          "    super._update(f, depot, fare);",
          "    super._update(f, t, v - fare);",
          "  }",
          "}"
        ]
      },
