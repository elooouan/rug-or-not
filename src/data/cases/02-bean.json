      "content": {
        "fileName": "contracts/BeanToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract BeanToken is ERC20 {",
          "  uint256 public constant TAX_BPS = 100; // 1%",
          "  address public immutable treasury;",
          "",
          "  constructor(address _treasury) ERC20(\"Bean\", \"BEAN\") {",
          "    treasury = _treasury;",
          "    _mint(msg.sender, 10_000_000 * 1e18); // fixed",
          "  }",
          "",
          "  function _update(address from, address to, uint256 v)",
          "    internal override {",
          "    uint256 fee = v * TAX_BPS / 10_000;",
          "    super._update(from, treasury, fee);",
          "    super._update(from, to, v - fee);",
          "  }",
          "  // No mint, no owner, no pause. Ownership renounced",
          "  // at deploy (tx 0x4b1...e2).",
          "}"
        ]
      },
