  "timeLimitSec": 240,
  "debrief": "Harbor has a fee, a treasury and a named team, all of which can look alarming if you squint. But the fee is hard-capped in code, the treasury is a co-op multisig with published minutes, the audit found real (small) issues that were fixed, and the admin answered the awkward question instead of deleting it.",
  "documents": [
    {
      "type": "contract",
      "title": "HarborToken.sol",
      "content": {
        "fileName": "contracts/HarborToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract HarborToken is ERC20 {",
          "  uint16 public constant FEE_BPS = 200;   // 2%, fixed",
          "  address public immutable boatFund;       // co-op multisig",
          "",
          "  constructor(address fund) ERC20(\"Harbor\", \"HRBR\") {",
          "    boatFund = fund;",
          "    _mint(fund, 8_000_000e18);",
          "  }",
          "",
          "  function _update(address from, address to, uint256 v)",
          "    internal override {",
          "    if (from == boatFund || to == boatFund) {",
          "      super._update(from, to, v); return;",
          "    }",
          "    uint256 fee = v * FEE_BPS / 10_000;",
          "    super._update(from, boatFund, fee);",
          "    super._update(from, to, v - fee);",
          "  }",
          "  // No owner. No setters. Fee cannot change.",
          "}"
        ]
      },
