        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract KelpToken is ERC20Votes {",
          "  constructor(address treasury, address pool)",
          "    ERC20(\"Kelp\", \"KELP\") ERC20Permit(\"Kelp\") {",
          "    _mint(treasury, 6_000_000e18);",
          "    _mint(pool, 4_000_000e18);",
          "  }",
          "  // Governance token only. No fees, no admin,",
          "  // no upgrade path. Treasury spends via DAO vote.",
          "}"
        ]
      },
