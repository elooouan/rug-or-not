  "debrief": "TideWorks buried its red flags under paperwork. The 'compliance list' was a blacklist; the fee cap was 100%; three 'independent' whales were funded by the deployer in the same block; and the whitepaper borrowed its risk section, typos included, from another project. The genuine parts, a vested marketing wallet, a doxxed ops lead, real jokes in chat, were there to make you stop looking.",
  "documents": [
    {
      "type": "contract",
      "title": "TideWorks.sol",
      "content": {
        "fileName": "contracts/TideWorks.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract TideWorks is ERC20, Ownable {",
          "  uint256 public constant MAX_FEE_BPS = 10_000;",
          "  uint256 public buyFeeBps = 100;",
          "  uint256 public sellFeeBps = 100;",
          "  mapping(address => bool) public complianceList;",
          "",
          "  function setFees(uint256 b, uint256 s) external onlyOwner {",
          "    require(b <= MAX_FEE_BPS && s <= MAX_FEE_BPS, \"cap\");",
          "    buyFeeBps = b; sellFeeBps = s;",
          "  }",
          "",
          "  function setCompliance(address a, bool flagged)",
          "    external onlyOwner { complianceList[a] = flagged; }",
          "",
          "  function _update(address from, address to, uint256 v)",
          "    internal override {",
          "    require(!complianceList[from], \"compliance hold\");",
          "    uint256 fee = v * (to == pool ? sellFeeBps : buyFeeBps)",
          "      / 10_000;",
          "    super._update(from, treasury, fee);",
          "    super._update(from, to, v - fee);",
          "  }",
          "}"
        ]
      },
