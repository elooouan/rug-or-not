        "fileName": "contracts/PixlToken.sol",
        "verified": true,
        "lines": [
          "// SPDX-License-Identifier: MIT",
          "pragma solidity 0.8.24;",
          "contract PixlToken is ERC20, Ownable {",
          "  uint256 public constant MAX_SUPPLY = 50_000_000e18;",
          "",
          "  constructor() ERC20(\"PixelForge\", \"PIXL\") {",
          "    _mint(msg.sender, MAX_SUPPLY);",
          "    // Deployer distributed to vesting + pool, then:",
          "    renounceOwnership();",
          "  }",
          "",
          "  // No tax, no blacklist, no pause. Plain ERC20.",
          "  function burn(uint256 amount) external {",
          "    _burn(msg.sender, amount);",
          "  }",
          "}"
        ]
