{
  "name": "rug-or-not",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "A pixel-art noir detective game about spotting crypto rug pulls. All cases are fictional.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-cases": "tsx scripts/validate-cases.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
